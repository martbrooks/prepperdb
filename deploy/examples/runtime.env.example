# Copy to /etc/prepperdb/runtime.env, fill in your own values, mode 0640 root:prepperdb.
# Values use shell/environment-file syntax; the app does not load this file itself.
PREPPERDB_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
PREPPERDB_ALLOWED_HOSTS=stock.example.org
PREPPERDB_STATE_DIR=/var/lib/prepperdb
PREPPERDB_STATIC_ROOT=/srv/prepperdb/static
PREPPERDB_TRUSTED_PROXIES=localhost
PREPPERDB_SOCKET=/run/prepperdb/app.sock
PREPPERDB_HTTPS=1
# Usually unnecessary for a normal same-origin deployment. For nonstandard ports:
# PREPPERDB_CSRF_TRUSTED_ORIGINS=https://stock.example.org:8443
