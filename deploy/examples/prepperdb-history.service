[Unit]
Description=Remove expired PrepperDB stock history
After=prepperdb.service
[Service]
Type=oneshot
User=prepperdb
Group=prepperdb-web
SupplementaryGroups=prepperdb
WorkingDirectory=/opt/prepperdb
EnvironmentFile=/etc/prepperdb/runtime.env
ExecStart=/opt/prepperdb/.venv/bin/python manage.py prune_stock_history
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prepperdb
